{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/sandbox/create/route.ts": { "maxDuration": 60 },
    "src/app/api/sandbox/**/*.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 * * * *"
    }
  ]
}
