{
  "name": "opencode-cloud",
  "version": "1.2.0",
  "description": "تشغيل OpenCode الأصلي داخل Vercel Sandbox مع واجهته الكاملة — AI Agent، Terminal، Git، جلسات متعددة، ودعم Android",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "sandbox:bootstrap": "tsx scripts/bootstrap-sandbox.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@octokit/rest": "^21.1.1",
    "@vercel/blob": "^1.1.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/postgres": "^0.10.0",
    "@vercel/sandbox": "^1.4.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.4",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "15.3.4",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.19.0",
    "eslint-config-next": "15.3.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
