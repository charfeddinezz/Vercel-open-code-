# ── Vercel Platform (اسحبها بـ vercel env pull) ──
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Auth ──
# مفتاح تشفير JWT وسري NextAuth
AUTH_SECRET="openssl rand -base64 32"
AUTH_URL="https://your-app.vercel.app"
# GitHub OAuth App
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# كلمة مرور عامة اختيارية للوصول (اختيارية إن لم تستخدم حسابات)
OPENCODE_SERVER_PASSWORD=

# ── AI ──
OPENROUTER_API_KEY=sk-or-v1-...

# ── Storage ──
# Vercel Postgres (أو Neon)
POSTGRES_URL=
# Vercel Blob لحفظ snapshots
BLOB_READ_WRITE_TOKEN=
# Vercel KV للـ sessions والـ heartbeat
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Encryption ──
# مفتاح تشفير مفاتيح المستخدمين (32 bytes base64)
ENCRYPTION_KEY="openssl rand -base64 32"

# ── Public ──
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
